# ============================================================
# .gitignore สำหรับ PyTorch / Deep Learning Project
# ============================================================

# ------------------------------------------------------------
# Model weights & checkpoints  (ไฟล์ใหญ่ — ห้าม push เด็ดขาด)
# ------------------------------------------------------------
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
checkpoints/
weights/
saved_models/
runs/

# ------------------------------------------------------------
# Data  (dataset ควร download แยก ไม่เก็บใน repo)
# ------------------------------------------------------------
data/
datasets/
*.csv
*.tsv
*.parquet
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle

# ยกเว้น: sample data เล็กๆ สำหรับ test
!data/sample/
!tests/fixtures/

# ------------------------------------------------------------
# Audio & Image files  (raw data ไม่ควรอยู่ใน repo)
# ------------------------------------------------------------
*.wav
*.mp3
*.flac
*.ogg
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff

# ยกเว้น: รูปใน assets/ (architecture diagram ฯลฯ)
!assets/
!docs/

# ------------------------------------------------------------
# Jupyter Notebooks — output cells  
# (commit แค่ clean notebook ไม่มี output)
# ------------------------------------------------------------
# วิธีที่ดีกว่า: ใช้ nbstripout แทน ignore ทั้งไฟล์
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ------------------------------------------------------------
# Virtual environments
# ------------------------------------------------------------
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/

# ------------------------------------------------------------
# Experiment tracking & logs
# ------------------------------------------------------------
wandb/
mlruns/
lightning_logs/
logs/
log/
*.log
tensorboard/
tb_logs/
events.out.tfevents.*

# ------------------------------------------------------------
# Output & results  (regenerate ได้จากโค้ด)
# ------------------------------------------------------------
outputs/
results/
predictions/
figures/
plots/
*.pdf
# ยกเว้น paper/report PDF
!paper/
!docs/*.pdf

# ------------------------------------------------------------
# Hugging Face cache
# ------------------------------------------------------------
.cache/
~/.cache/huggingface/

# ------------------------------------------------------------
# Environment & secrets  (สำคัญมาก — ห้าม push API keys)
# ------------------------------------------------------------
.env
.env.local
.env.*.local
secrets.yaml
secrets.json
config/secrets/
*.key
*.pem

# ------------------------------------------------------------
# OS files
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# IDE & editors
# ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------
# Testing & coverage
# ------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover

# ------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------
tmp/
temp/
.tmp/
*.tmp
*.temp
*.bak
*.backup
